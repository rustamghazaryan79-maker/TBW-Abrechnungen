<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:form="sap.ui.layout.form">
	<ResponsivePopover
		id="absenceDetail"
		title="{view>/detail/title}"
		placement="Auto"
		contentWidth="22rem"
		class="sapUiContentPadding">
		<content>
			<form:SimpleForm editable="false" layout="ColumnLayout">
				<form:content>
					<Label text="{i18n>detailEmployee}"/>
					<Text text="{view>/detail/employee}"/>
					<Label text="{i18n>detailType}"/>
					<Text text="{view>/detail/type}"/>
					<Label text="{i18n>detailPeriod}"/>
					<Text text="{view>/detail/period}"/>
					<Label text="{i18n>detailDuration}"/>
					<Text text="{view>/detail/duration}"/>
					<Label text="{i18n>detailStatus}"/>
					<ObjectStatus
						text="{view>/detail/statusText}"
						state="{view>/detail/statusState}"
						icon="{view>/detail/statusIcon}"/>
					<Label text="{i18n>detailSource}"/>
					<Text text="{view>/detail/source}"/>
				</form:content>
			</form:SimpleForm>
		</content>
		<endButton>
			<Button text="{i18n>btnClose}" press=".onCloseDetail"/>
		</endButton>
	</ResponsivePopover>
</core:FragmentDefinition>
